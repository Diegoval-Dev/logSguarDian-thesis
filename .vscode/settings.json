{
    "latex-workshop.latex.rootFile.doNotUseGitignore": true,
    "latex-workshop.latex.rootFile.path": "${workspaceFolder}/z-main.tex",
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk",
            "command": "/Library/TeX/texbin/latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-pdf",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ]
        }
    ]
}
